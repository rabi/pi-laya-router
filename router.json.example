{
  "serveUrl": "http://10.37.137.29:8000",
  "model": "laya",
  "timeoutMs": 10000,
  "minConfidence": 0.5,
  "defaultRoute": "quick",
  "routing": {
    "enabled": true,
    "maxPromptChars": 8000,

    // Session lock: classify only the first prompt of a session, then keep that
    // model so its prompt cache stays warm. /laya-router reroute re-classifies.
    "stickySession": false,

    // Intent-only routing is the DEFAULT: re-classify each prompt but switch
    // only when the challenger clearly beats the incumbent. These knobs are
    // optional — set them only to tune the defaults.
    // "switchPolicy": {
    //   "minMargin": 0.15,     // score gap required to leave the current route
    //   "minAbsolute": 0.3     // below this the prompt matches nothing; stay put
    // },
    // "switchPolicy": false   // opt out: raw classify-every-prompt routing,
    //                         // switches on any classification change (no gate)

    // Cheap-model compaction: on a real model switch, triggers pi's native
    // compaction but intercepts it to use this model for the summary instead
    // of the (potentially expensive) current model.
    // "summarizer": {
    //   "enabled": true,
    //   "provider": "rhcorp",
    //   "model": "Qwen/Qwen3.8-27B-FP8",
    //   "thinkingLevel": "low",
    //   "maxTokens": 1024,
    //   "timeoutMs": 30000
    // }
  },
  "routes": {
    "reasoning": {
      "provider": "local",
      "model": "RedHatAI/Qwen3.8-27B-INT4",
      "description": "Deep reasoning, math, architecture design, hard debugging"
    },
    "code": {
      "provider": "openai",
      "model": "REPLACE-ME",
      "description": "Writing, editing, refactoring code; routine implementation tasks"
    },
    "quick": {
      "provider": "openai",
      "model": "REPLACE-ME",
      "description": "Simple questions, lookups, small talk, one-line answers"
    }
  }
}
